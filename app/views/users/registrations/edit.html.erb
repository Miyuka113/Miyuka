<div class="edit-profile-container">
  <div class="edit-profile-card">

    <h1 class="mypage-title">プロフィール編集</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :name, "ユーザー名" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name" %>
      </div>

      <div class="field">
        <%= f.label :image, "プロフィール画像" %>
        <%= f.file_field :image %>
      </div>

      <div class="field">
        <%= f.label :profile, "自己紹介" %>
        <%= f.text_area :profile %>
      </div>

      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autocomplete: "email" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p>現在、確認待ちのメールアドレス：<%= resource.unconfirmed_email %></p>
      <% end %>

      <div class="field">
        <%= f.label :password, "新しいパスワード" %>
        <p class="form-note">変更しない場合は空欄でOK</p>
        <%= f.password_field :password, autocomplete: "new-password" %>

        <% if @minimum_password_length %>
          <p class="form-note"><%= @minimum_password_length %>文字以上</p>
        <% end %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "新しいパスワード確認" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="field">
        <%= f.label :current_password, "現在のパスワード" %>
        <p class="form-note">変更を保存するために入力してください</p>
        <%= f.password_field :current_password, autocomplete: "current-password" %>
      </div>

      <div class="actions">
        <%= f.submit "保存する", class: "login-btn" %>
      </div>
    <% end %>

    <div class="login-links">
      <%= link_to "← 戻る", :back %>
    </div>

    <div class="delete-account-box">
      <h3>アカウント削除</h3>

      <%= button_to "アカウントを削除する",
        registration_path(resource_name),
        data: {
          confirm: "本当に削除しますか？",
          turbo_confirm: "本当に削除しますか？"
        },
        method: :delete,
        class: "delete-btn" %>
    </div>

  </div>
</div>