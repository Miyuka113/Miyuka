<div class="page-layout">

  <div class="sidebar timeline-sidebar">

    <h3>投稿を検索</h3>

    <%= form_tag(tweets_path, method: :get) do %>
      <%= text_field_tag :search %>
      <%= submit_tag "検索する" %>
    <% end %>

    <h3>タグ検索</h3>

    <%= form_tag(tweets_path, method: :get) do %>
      <% Tag.all.each do |tag| %>
        <div>
          <label>
            <%= check_box_tag "tag_ids[]", tag.id %>
            <%= tag.name %>
          </label>
        </div>
      <% end %>

      <%= submit_tag "検索" %>
    <% end %>

  </div>

  <div class="main-content">

    <h1 class="timeline-title">タイムライン</h1>

    <div class="tweets-container">

      <% @tweets.each do |t| %>

        <div class="tweet-card" id="tweet-<%= t.id %>">

          <div class="user-info">
            <% if t.user&.image&.attached? %>
              <%= image_tag t.user.image, class: "user-icon" %>
            <% else %>
              <%= image_tag "default.png", class: "user-icon" %>
            <% end %>

            <p class="user-name"><%= t.user.name %></p>
          </div>

          <% if t.image.attached? %>
            <%= image_tag url_for(t.image), class: "tweet-image" %>
          <% end %>

          <h3><%= t.title %></h3>

          <p>📍 <%= t.place %></p>
          <p>👥 <%= t.people %>人</p>
          <p>💰 <%= t.budget %>円</p>
          <p>🏷️ <%= t.genre %></p>

          <%= link_to "詳細へ →", tweet_path(t.id), class: "detail-link" %>

          <div class="like-area">

            <% if user_signed_in? %>

              <% if current_user.already_liked?(t) %>
                <%= button_to "♡",
                  tweet_like_path(t, current_user.likes.find_by(tweet_id: t.id)),
                  method: :delete,
                  form: { data: { turbo: false } },
                  class: "like-btn heart-btn liked" %>
              <% else %>
                <%= button_to "♡",
                  tweet_likes_path(t),
                  method: :post,
                  form: { data: { turbo: false } },
                  class: "like-btn heart-btn" %>
              <% end %>

            <% end %>

            <p class="like-count"><%= t.likes.count %> いいね</p>

          </div>

        </div>

      <% end %>

    </div>

  </div>

  <div class="recommend-sidebar">
    <h2>おすすめの遊び！</h2>

    <% @recommended_tweets.each do |r| %>
      <div class="recommend-card">

        <% if r.image.attached? %>
          <%= image_tag r.image, class: "recommend-image" %>
        <% end %>

        <div class="recommend-info">
          <h3><%= r.title %></h3>
          <p>📍 <%= r.place %></p>
          <p>👥 <%= r.people %>人</p>
          <%= link_to "詳細を見る", tweet_path(r), class: "recommend-link" %>
        </div>

      </div>
    <% end %>
  </div>

</div>

<%
tips = [
  "💖 気になる遊びは<br>♡してみよう！",
  "👀 みんなの遊びを<br>のぞいてみよう！",
  "🎈 お気に入りを<br>集めよう！",
  "✨ 遊びに迷ったら<br>検索してみよう！",
  "🌸 新しい趣味との<br>出会いがあるかも！",
  "🎮 今日の遊びを<br>見つけよう！",
  "👀 みんなは何して<br>遊んでるかな？",
  "🎉 ワクワクする遊びを<br>探そう！",
  "📖 今日はどんな思い出を<br>作る？",
  "🗺️ 行ったことのない場所へ<br>出かけてみない？",
  "🚗 次の休日の予定は<br>決まった？"
]
%>

<div class="timeline-tip">
  <%= tips.sample.html_safe %>
</div>