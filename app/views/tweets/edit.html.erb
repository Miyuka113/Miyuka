<h1 class="new-title">投稿を編集する</h1>

<div class="new-form">
  <%= form_for @tweet do |f| %>

    <div class="form-group">
      <%= f.label :title, "タイトル" %>
      <%= f.text_field :title, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :place, "場所" %>
      <%= f.text_field :place, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :people, "人数" %>
      <%= f.number_field :people, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :budget, "予算" %>
      <%= f.number_field :budget, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :genre, "ジャンル" %>
      <%= f.text_field :genre, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :image, "画像" %>
      <%= f.file_field :image, class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= f.submit "更新する", class: "submit-btn" %>
    </div>

  <% end %>

  <div class="back-link">
    <%= link_to "詳細に戻る", tweet_path(@tweet) %>
  </div>
</div>